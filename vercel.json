{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.nzembo.net",
      "permanent": false
    },
    {
      "source": "/app/(.*)",
      "destination": "https://app.nzembo.net/$1",
      "permanent": false
    },
    {
      "source": "/invite/(.*)",
      "destination": "https://app.nzembo.net/invite/$1",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://admin.nzembo.net",
      "permanent": false
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://admin.nzembo.net/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    }
  ]
}
